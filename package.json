{
  "name": "khqr-payment",
  "version": "1.0.0",
  "description": "KHQR payment system with automatic transaction check (Bakong Open API)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check src/app.js && node --check api/index.js"
  },
  "dependencies": {
    "bakong-khqr": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.0",
    "qrcode": "^1.5.4"
  }
}
