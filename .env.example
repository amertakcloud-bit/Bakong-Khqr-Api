# ===== Required (copy this file to .env and fill in YOUR values) =====
NODE_ENV=development
PORT=5000
MONGODB_URI=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
CLIENT_URL=http://localhost:5000

# ===== Receiving account (needed to build the KHQR) =====
# Your own Bakong account ID, format name@bank (shown in your bank app's KHQR / Bakong profile)
BAKONG_ACCOUNT_ID=
# Shown to the payer. Max 25 characters.
MERCHANT_NAME=
# Max 15 characters.
MERCHANT_CITY=Phnom Penh

# ===== Optional tuning (defaults shown) =====
# DEFAULT_CURRENCY=KHR
# ORDER_EXPIRE_MINUTES=10
# MIN_AMOUNT_USD=0.01
# MAX_AMOUNT_USD=500
# MIN_AMOUNT_KHR=100
# MAX_AMOUNT_KHR=2000000
# CHECK_MIN_INTERVAL_SECONDS=4
# MAX_PENDING_PER_IP=5
# BAKONG_TIMEOUT_MS=8000
# REQUIRE_RECEIVER_MATCH=true
# Any random string; makes the stored IP hashes unguessable
# IP_HASH_SALT=

# ===== Render only (long-running server). Leave false/unset on Vercel. =====
# BACKGROUND_POLLING=true
# BACKGROUND_POLL_INTERVAL_SECONDS=10
